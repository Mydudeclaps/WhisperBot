DISCORD_TOKEN=
DISCORD_TOKEN_FILE=/run/secrets/discord_token
CLIENT_ID=
GUILD_ID=
WHISPERBOT_DB_PATH=/data/whisperbot.db
WHISPERBOT_HEALTH_PATH=/tmp/whisperbot-health.json
